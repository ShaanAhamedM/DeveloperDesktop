# Set default behavior to normalize line endings
* text=auto eol=lf

# Force LF on shell scripts and Linux configurations
*.sh text eol=lf
*.conf text eol=lf
*.rasi text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.css text eol=lf
*.py text eol=lf
*.md text eol=lf
*.lua text eol=lf
*.toml text eol=lf
LICENSE text eol=lf

# Force CRLF on Windows batch files
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
