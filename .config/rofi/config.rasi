/**
 * Minimalist Spotlight Rofi Configuration
 * Maintained by: Shaan
 */

configuration {
    modi:                       "drun,run,window";
    font:                       "JetBrainsMono Nerd Font 10.5";
    show-icons:                 true;
    icon-theme:                 "Papirus-Dark";
    display-drun:               "";
    display-run:                "";
    display-window:             "";
    drun-display-format:        "{name}";
    window-format:              "{w} · {c} · {t}";
}

@theme "styles/colors.rasi"

* {
    background-color: transparent;
    text-color:       @fg;
    margin:           0px;
    padding:          0px;
    spacing:          0px;
}

window {
    transparency:     "real";
    location:         center;
    anchor:           center;
    width:            640px;
    border:           1px solid;
    border-color:     @border-col;
    border-radius:    8px;
    background-color: @bg;
    padding:          16px;
}

mainbox {
    spacing:          12px;
    children:         [ "inputbar", "listview" ];
}

inputbar {
    spacing:          10px;
    padding:          8px 12px;
    background-color: @bg-alt;
    border:           1px solid;
    border-color:     @border-subtle;
    border-radius:    6px;
    children:         [ "prompt", "entry" ];
}

prompt {
    text-color:       @bg-selected;
}

entry {
    placeholder:       "Search apps or commands...";
    placeholder-color: @fg-alt;
    text-color:        @fg;
}

listview {
    columns:          1;
    lines:            7;
    cycle:            true;
    dynamic:          true;
    scrollbar:        false;
    layout:           vertical;
    spacing:          4px;
}

element {
    padding:          8px 12px;
    border-radius:    6px;
    spacing:          10px;
}

element normal.normal {
    background-color: transparent;
    text-color:       @fg;
}

element selected.normal {
    background-color: @bg-selected;
    text-color:       @fg-selected;
}

element-icon {
    size:             20px;
}

element-text {
    vertical-align:   0.5;
    text-color:       inherit;
}
