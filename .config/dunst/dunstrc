[global]
    font = JetBrainsMono Nerd Font 10
    frame_width = 1
    frame_color = "#89dceb"
    separator_color = "#313244"
    corner_radius = 8
    offset = 12x12
    origin = top-right
    padding = 12
    horizontal_padding = 14
    icon_position = left
    min_icon_size = 24
    max_icon_size = 32
    background = "#11111be6"
    foreground = "#cdd6f4"

[urgency_low]
    background = "#11111be6"
    foreground = "#cdd6f4"
    frame_color = "#313244"
    timeout = 3

[urgency_normal]
    background = "#11111be6"
    foreground = "#cdd6f4"
    frame_color = "#89dceb"
    timeout = 5

[urgency_critical]
    background = "#11111be6"
    foreground = "#f38ba8"
    frame_color = "#f38ba8"
    timeout = 0
