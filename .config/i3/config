# ==============================================================================
#  i3 Window Manager Configuration - Nordic Charcoal Minimalist
#  Maintained by: Shaan
# ==============================================================================
#  Universal X11 / RDP fallback configuration sharing exact parity with Hyprland.
# ==============================================================================

# Super / Windows key
set $mod Mod4

# Font
font pango:JetBrains Mono Nerd Font 10

# Thin borders (1px) and 8px uniform gaps
default_border pixel 1
default_floating_border pixel 1
hide_edge_borders smart
gaps inner 4
gaps outer 4

# --- Color Scheme (Nordic Charcoal Spec) ---
# class                 border  bground text    indicator child_border
client.focused          #89dceb #181825 #cdd6f4 #89dceb   #89dceb
client.focused_inactive #313244 #181825 #6c7086 #313244   #313244
client.unfocused        #313244 #11111b #6c7086 #313244   #313244
client.urgent           #f38ba8 #181825 #f38ba8 #f38ba8   #f38ba8
client.placeholder      #181825 #11111b #cdd6f4 #181825   #181825

# --- Autostart Wallpaper & Daemons ---
exec_always --no-startup-id feh --bg-fill "$HOME/.config/wallpapers/minimalist-dark.png" 2>/dev/null || true
exec --no-startup-id xterm -title "btop" -e btop

# --- Keybindings (Core Requirement 2) ---
# Launch Terminal & Launcher
bindsym $mod+Return exec env LIBGL_ALWAYS_SOFTWARE=1 kitty || xterm
bindsym Mod1+Return exec env LIBGL_ALWAYS_SOFTWARE=1 kitty || xterm
bindsym $mod+space exec rofi -show drun
bindsym Mod1+space exec rofi -show drun
bindsym $mod+w exec rofi -show window
bindsym Mod1+w exec rofi -show window
bindsym $mod+m exec xterm -title "btop" -e btop
bindsym Mod1+m exec xterm -title "btop" -e btop

# Window Control
bindsym $mod+q kill
bindsym Mod1+q kill
bindsym $mod+f fullscreen toggle
bindsym Mod1+f fullscreen toggle
bindsym $mod+v floating toggle
bindsym $mod+s layout stacking
bindsym $mod+t layout tabbed
bindsym $mod+e layout toggle split

# Focus Navigation (Vim & Arrow keys)
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move Windows (Vim & Arrow keys)
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Workspaces
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"

# Switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9

# Move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9

# Automatic Workspace Assignment (Bonus Requirement)
assign [class="(?i)code"] $ws1
assign [class="(?i)firefox"] $ws2
assign [class="(?i)chrome"] $ws2
assign [class="(?i)slack"] $ws4
assign [class="(?i)discord"] $ws4
assign [class="(?i)spotify"] $ws5

# Scratchpad Dropdown Terminal
bindsym $mod+grave [instance="scratchpad_terminal"] scratchpad show; [instance="scratchpad_terminal"] move position center
bindsym $mod+Shift+grave move scratchpad

# Screenshots
bindsym Print exec maim -s | xclip -selection clipboard -t image/png 2>/dev/null || true
bindsym $mod+Shift+s exec maim -s | xclip -selection clipboard -t image/png 2>/dev/null || true

# Power Menu & Cheatsheet
bindsym $mod+Shift+slash exec "$HOME/.config/scripts/cheat_sheet.sh"
bindsym $mod+Shift+e exec "$HOME/.config/scripts/power_menu.sh"

# Reload / Restart i3 inplace
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart

# Minimalist Top Status Bar
bar {
    position top
    status_command while true; do ~/.config/scripts/sys_metrics.sh --all 2>/dev/null | grep -E "CPU|RAM|Battery|Storage" | tr '\n' '  '; date +'%H:%M:%S  %a %d %b'; sleep 2; done
    colors {
        background #11111b
        statusline #cdd6f4
        separator  #313244

        focused_workspace  #89dceb #89dceb #11111b
        active_workspace   #181825 #181825 #cdd6f4
        inactive_workspace #11111b #11111b #6c7086
        urgent_workspace   #f38ba8 #f38ba8 #11111b
    }
}
